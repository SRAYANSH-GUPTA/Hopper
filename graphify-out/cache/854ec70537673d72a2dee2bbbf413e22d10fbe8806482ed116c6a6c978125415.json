       onClick={(event) => {\n              event.preventDefault();\n              event.stopPropagation();\n              onOpenThreadLink?.(threadId);\n            }}\n          >\n            {children}\n          </a>\n        );\n      }\n      if (isFileLinkUrl(url)) {\n        const path = parseFileLinkUrl(url);\n        if (!path) {\n          return (\n            <a\n              href={href}\n              onClick={(event) => {\n                event.preventDefault();\n                event.stopPropagation();\n              }}\n            >\n              {children}\n            </a>\n          );\n        }\n        return (\n          <FileReferenceLink\n            href={href ?? toFileLink(path)}\n            rawPath={path}\n            showFilePath={showFilePath}\n            workspacePath={workspacePath}\n            onClick={handleFileLinkClick}\n            onContextMenu={handleFileLinkContextMenu}\n          />\n        );\n      }", "source_file": "src/features/messages/components/Markdown.tsx", "source_location": "L485"}, {"caller_nid": "markdown_markdown", "callee": "formatParsedFileLocation", "source_file": "src/features/messages/components/Markdown.tsx", "source_location": "L534"}, {"caller_nid": "markdown_markdown", "callee": "startsWith", "source_file": "src/features/messages/components/Markdown.tsx", "source_location": "L552"}, {"caller_nid": "markdown_markdown", "callee": "startsWith", "source_file": "src/features/messages/components/Markdown.tsx", "source_location": "L553"}, {"caller_nid": "markdown_markdown", "callee": "startsWith", "source_file": "src/features/messages/components/Markdown.tsx", "source_location": "L554"}, {"caller_nid": "markdown_markdown", "callee": "startsWith", "source_file": "src/features/messages/components/Markdown.tsx", "source_location": "L557"}]}